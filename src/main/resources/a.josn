        "arguments": "{\"relativeFilePath\": \"src/pages/AboutPage.vue\", \"content\": \"<template>\\n  <div class=\\\"about-page\\\">\\n    <div class=\\\"container\\\">\\n      <div class=\\\"page-header\\\">\\n        <h1>关于我们</h1>\\n        <p class=\\\"subtitle\\\">了解我们的使命、愿景和价值观</p>\\n      </div>\\n\\n      <div class=\\\"about-content\\\">\\n        <div class=\\\"about-section\\\">\\n          <h2>我们的使命</h2>\\n          <p>帮助个人和团队更高效地管理任务，提升工作质量和生活品质。我们相信，良好的任务管理是成功的基础。</p>\\n        </div>\\n\\n        <div class=\\\"about-section\\\">\\n          <h2>我们的愿景</h2>\\n          <p>成为全球领先的任务管理解决方案提供商，让每个人都能轻松掌控自己的时间和目标，实现工作与生活的完美平衡。</p>\\n        </div>\\n\\n        <div class=\\\"about-section\\\">\\n          <h2>核心价值观</h2>\\n          <ul class=\\\"values-list\\\">\\n            <li><strong>用户至上：</strong>始终把用户需求放在首位，提供简单易用的产品体验</li>\\n            <li><strong>持续创新：</strong>不断探索新技术，优化产品功能和用户体验</li>\\n            <li><strong>追求卓越：</strong>对产品质量和细节精益求精，打造行业标杆</li>\\n            <li><strong>团队协作：</strong>倡导开放、包容、互助的团队文化</li>\\n          </ul>\\n        </div>\\n\\n        <div class=\\\"team-section\\\">\\n          <h2>核心团队</h2>\\n          <div class=\\\"team-grid\\\">\\n            <div class=\\\"team-member\\\">\\n              <div class=\\\"member-avatar\\\">👨‍💻</div>\\n              <h3>张明</h3>\\n              <p class=\\\"role\\\">创始人 & CEO</p>\\n              <p class=\\\"bio\\\">拥有10年软件开发经验，专注于生产力工具研发</p>\\n            </div>\\n            <div class=\\\"team-member\\\">\\n              <div class=\\\"member-avatar\\\">👩‍🎨</div>\\n              <h3>李华</h3>\\n              <p class=\\\"role\\\">首席设计师</p>\\n              <p class=\\\"bio\\\">UI/UX设计专家，致力于创造优雅的用户体验</p>\\n            </div>\\n            <div class=\\\"team-member\\\">\\n              <div class=\\\"member-avatar\\\">👨‍🔧</div>\\n              <h3>王强</h3>\\n              <p class=\\\"role\\\">技术总监</p>\\n              <p class=\\\"bio\\\">全栈工程师，负责技术架构和系统稳定性</p>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  </div>\\n</template>\\n\\n<script setup>\\n// No script needed for this page\\n</script>\\n\\n<style scoped>\\n.about-page {\\n  padding: 2rem 0;\\n}\\n\\n.page-header {\\n  text-align: center;\\n  margin-bottom: 3rem;\\n}\\n\\n.page-header h1 {\\n  font-size: 2.5rem;\\n  color: #2c3e50;\\n  margin-bottom: 1rem;\\n}\\n\\n.subtitle {\\n  font-size: 1.2rem;\\n  color: #6c757d;\\n}\\n\\n.about-content {\\n  max-width: 800px;\\n  margin: 0 auto;\\n}\\n\\n.about-section {\\n  margin-bottom: 3rem;\\n}\\n\\n.about-section h2 {\\n  font-size: 1.8rem;\\n  color: #4a6fa5;\\n  margin-bottom: 1rem;\\n}\\n\\n.about-section p {\\n  font-size: 1.1rem;\\n  line-height: 1.6;\\n  color: #495057;\\n}\\n\\n.values-list {\\n  list-style: none;\\n  padding: 0;\\n}\\n\\n.values-list li {\\n  margin-bottom: 0.75rem;\\n  padding-left: 2rem;\\n  position: relative;\\n}\\n\\n.values-list li::before {\\n  content: \\\"✓\\\";\\n  position: absolute;\\n  left: 0;\\n  color: #4a6fa5;\\n  font-weight: bold;\\n}\\n\\n.team-section {\\n  margin-top: 3rem;\\n}\\n\\n.team-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit,"
