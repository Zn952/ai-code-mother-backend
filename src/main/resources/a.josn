        "arguments": "{\"relativeFilePath\": \"src/pages/HomePage.vue\", \"content\": \"<template>\\n  <div class=\\\"home-page\\\">\\n    <section class=\\\"hero-section\\\">\\n      <div class=\\\"container\\\">\\n        <h1>📝 任务记录网站</h1>\\n        <p class=\\\"subtitle\\\">高效管理您的日常任务，提升工作效率</p>\\n        <div class=\\\"hero-buttons\\\">\\n          <router-link to=\\\"/tasks\\\" class=\\\"btn btn-primary\\\">查看任务列表</router-link>\\n          <router-link to=\\\"/tasks\\\" class=\\\"btn btn-secondary\\\">添加新任务</router-link>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"features-section\\\">\\n      <div class=\\\"container\\\">\\n        <h2 class=\\\"section-title\\\">功能特色</h2>\\n        <div class=\\\"features-grid\\\">\\n          <div class=\\\"feature-card\\\">\\n            <div class=\\\"feature-icon\\\">✅</div>\\n            <h3>任务管理</h3>\\n            <p>轻松创建、编辑、删除和跟踪任务状态</p>\\n          </div>\\n          <div class=\\\"feature-card\\\">\\n            <div class=\\\"feature-icon\\\">⏰</div>\\n            <h3>时间提醒</h3>\\n            <p>设置截止日期，及时提醒重要任务</p>\\n          </div>\\n          <div class=\\\"feature-card\\\">\\n            <div class=\\\"feature-icon\\\">📊</div>\\n            <h3>进度统计</h3>\\n            <p>实时查看任务完成情况和工作进度</p>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"stats-section\\\">\\n      <div class=\\\"container\\\">\\n        <h2 class=\\\"section-title\\\">任务统计</h2>\\n        <div class=\\\"stats-grid\\\">\\n          <div class=\\\"stat-item\\\">\\n            <div class=\\\"stat-number\\\">24</div>\\n            <div class=\\\"stat-label\\\">总任务数</div>\\n          </div>\\n          <div class=\\\"stat-item\\\">\\n            <div class=\\\"stat-number\\\">16</div>\\n            <div class=\\\"stat-label\\\">待处理</div>\\n          </div>\\n          <div class=\\\"stat-item\\\">\\n            <div class=\\\"stat-number\\\">5</div>\\n            <div class=\\\"stat-label\\\">进行中</div>\\n          </div>\\n          <div class=\\\"stat-item\\\">\\n            <div class=\\\"stat-number\\\">3</div>\\n            <div class=\\\"stat-label\\\">已完成</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section class=\\\"testimonials-section\\\">\\n      <div class=\\\"container\\\">\\n        <h2 class=\\\"section-title\\\">用户评价</h2>\\n        <div class=\\\"testimonials-grid\\\">\\n          <div class=\\\"testimonial-card\\\">\\n            <div class=\\\"testimonial-content\\\">\\\"这个任务管理工具让我每天的工作变得井井有条，再也不用担心忘记重要事项了！\\\"</div>\\n            <div class=\\\"testimonial-author\\\">- 张经理，产品经理</div>\\n          </div>\\n          <div class=\\\"testimonial-card\\\">\\n            <div class=\\\"testimonial-content\\\">\\\"界面简洁美观，操作简单直观，非常适合团队协作使用。\\\"</div>\\n            <div class=\\\"testimonial-author\\\">- 李总监，技术负责人</div>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n  </div>\\n</template>\\n\\n<script setup>\\n// No script needed for this page\\n</script>\\n\\n<style scoped>\\n.home-page {\\n  background-color: #f8f9fa;\\n}\\n\\n.hero-section {\\n  background: linear-gradient(135deg, #4a6fa5, #2c3e50);\\n  color: white;\\n  padding: 6rem 0 4rem;\\n  text-align: center;\\n}\\n\\n.hero-section h1 {\\n  font-size: 3.5rem;\\n  margin-bottom: 1rem;\\n  font-weight: 700;\\n}\\n\\n.subtitle {\\n  font-size: 1.5rem;\\n  margin-bottom: 2rem;\\n  opacity: 0.9;\\n}\\n\\n.hero-buttons {\\n  display: flex;\\n  gap: 1rem;\\n  justify-content: center;\\n  flex-wrap: wrap;\\n}\\n\\n.features-section {\\n  padding: 4rem 0;\\n  background-color: white;\\n}\\n\\n.section-title {\\n  text-align: center;\\n  font-size: 2.5rem;\\n  margin-bottom: 3rem;\\n  color: #2c3e50;\\n}\\n\\n.features-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\\n  gap: 2rem;\\n}\\n\\n.feature-card {\\n  background: white;\\n  border-radius: 10px;\\n  padding: 2rem;\\n  box-shadow: 0 4px 6px rgba(0,0,0,0.1);\\n  text-align: center;\\n  transition: transform 0.3s ease;\\n}\\n\\n.feature-card:hover {\\n  transform: translateY(-5px);\\n}\\n\\n.feature-icon {\\n  font-size: 3rem;\\n  margin-bottom: 1rem;\\n}\\n\\n.feature-card h3 {\\n  font-size: 1.5rem;\\n  margin-bottom: 1rem;\\n  color: #4a6fa5;\\n}\\n\\n.stats-section {\\n  padding: 4rem 0;\\n  background-color: #f8f9fa;\\n}\\n\\n.stats-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\\n  gap: 2rem;\\n  text-align: center;\\n}\\n\\n.stat-item {\\n  background: white;\\n  border-radius: 10px;\\n  padding: 2rem;\\n  box-shadow: 0 4px 6px rgba(0,0,0,0.1);\\n}\\n\\n.stat-number {\\n  font-size: 3rem;\\n  font-weight: 700;\\n  color: #4a6fa5;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.stat-label {\\n  font-size: 1.1rem;\\n  color: #6c757d;\\n}\\n\\n.testimonials-section {\\n  padding: 4rem 0;\\n  background-color: white;\\n}\\n\\n.testimonials-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\\n  gap: 2rem;\\n}\\n\\n.testimonial-card {\\n  background: #f8f9fa;\\n  border-radius: 10px;\\n  padding: 2rem;\\n  position: relative;\\n}\\n\\n.testimonial-card::before {\\n  content: \\\"\\\\201C\\\";\\n  font-size: 5rem;\\n  position: absolute;\\n  top: -20px;\\n  left: 20px;\\n  color: #4a6fa5;\\n  opacity: 0.2;\\n}\\n\\n.testimonial-content {\\n  font-size: 1.2rem;\\n  font-style: italic;\\n  margin-bottom: 1.5rem;\\n  color: #495057;\\n}\\n\\n.testimonial-author {\\n  font-weight: 600;\\n  color: #4a6fa5;\\n}\\n\\n.btn {\\n  display: inline-block;\\n  padding: 0.75rem 2rem;\\n  border-radius: 6px;\\n  font-size: 1.1rem;\\n  font-weight: 600;\\n  text-decoration: none;\\n  transition: all 0.3s ease;\\n}\\n\\n.btn-primary {\\n  background-color: #4a6fa5;\\n  color: white;\\n}\\n\\n.btn-primary:hover {\\n  background-color: #3a5a80;\\n  transform: translateY(-2px);\\n}\\n\\n.btn-secondary {\\n  background-color: #6c757d;\\n  color: white;\\n}\\n\\n.btn-secondary:hover {\\n  background-color: #5a6268;\\n  transform: translateY(-2px);\\n}\\n\\n.container {\\n  max-width: 1200px;\\n  margin: 0 auto;\\n  padding: 0 20px;\\n}\\n\\n@media (max-width: 768px) {\\n  .hero-section h1 {\\n    font-size: 2.5rem;\\n  }\\n  \\n  .subtitle {\\n    font-size: 1.2rem;\\n  }\\n  \\n  .section-title {\\n    font-size: 2rem;\\n  }\\n  \\n  .stat-number {\\n    font-size: 2.5rem;\\n  }\\n}\\n\\n@media (max-width: 480px) {\\n  .hero-section {\\n    padding: 4rem 0 3rem;\\n  }\\n  \\n  .hero-section h1 {\\n    font-size: 2rem;\\n  }\\n  \\n  .subtitle {\\n    font-size: 1rem;\\n  }\\n  \\n  .hero-buttons {\\n    flex-direction: column;\\n    align-items: center;\\n  }\\n}\\n</style>\"}"
