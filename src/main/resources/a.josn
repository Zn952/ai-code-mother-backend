        "arguments": "{\"relativeFilePath\": \"src/pages/TaskListPage.vue\", \"content\": \"<template>\\n  <div class=\\\"task-list-page\\\">\\n    <div class=\\\"container\\\">\\n      <div class=\\\"page-header\\\">\\n        <h1>📋 任务列表</h1>\\n        <router-link to=\\\"/tasks/new\\\" class=\\\"btn btn-primary\\\">+ 添加任务</router-link>\\n      </div>\\n\\n      <div class=\\\"filters\\\">\\n        <div class=\\\"filter-group\\\">\\n          <label for=\\\"statusFilter\\\">状态：</label>\\n          <select id=\\\"statusFilter\\\" v-model=\\\"statusFilter\\\" @change=\\\"filterTasks\\\">\\n            <option value=\\\"all\\\">全部</option>\\n            <option value=\\\"pending\\\">待处理</option>\\n            <option value=\\\"in-progress\\\">进行中</option>\\n            <option value=\\\"completed\\\">已完成</option>\\n          </select>\\n        </div>\\n        <div class=\\\"filter-group\\\">\\n          <label for=\\\"priorityFilter\\\">优先级：</label>\\n          <select id=\\\"priorityFilter\\\" v-model=\\\"priorityFilter\\\" @change=\\\"filterTasks\\\">\\n            <option value=\\\"all\\\">全部</option>\\n            <option value=\\\"low\\\">低</option>\\n            <option value=\\\"medium\\\">中</option>\\n            <option value=\\\"high\\\">高</option>\\n          </select>\\n        </div>\\n      </div>\\n\\n      <div v-if=\\\"filteredTasks.length === 0\\\" class=\\\"no-tasks\\\">\\n        <div class=\\\"empty-state\\\">\\n          <div class=\\\"empty-icon\\\">📝</div>\\n          <h3>暂无任务</h3>\\n          <p>还没有创建任何任务，点击上方按钮开始添加您的第一个任务吧！</p>\\n          <router-link to=\\\"/tasks/new\\\" class=\\\"btn btn-primary\\\">添加任务</router-link>\\n        </div>\\n      </div>\\n\\n      <div v-else class=\\\"tasks-grid\\\">\\n        <TaskCard \\n          v-for=\\\"task in filteredTasks\\\" \\n          :key=\\\"task.id\\\" \\n          :task=\\\"task\\\" \\n          @status-updated=\\\"refreshTasks\\\"\\n        />\\n      </div>\\n    </div>\\n  </div>\\n</template>\\n\\n<script setup>\\nimport { ref, onMounted, computed } from 'vue'\\nimport TaskCard from '../components/TaskCard.vue'\\n\\n// 模拟任务数据\\nconst tasks = ref([\\n  {\\n    id: 1,\\n    title: '完成项目需求文档',\\n    description: '整理并完善项目的需求规格说明书，确保所有功能点都已覆盖',\\n    priority: 'high',\\n    status: 'in-progress',\\n    dueDate: '2024-01-15',\\n    createdAt: '2024-01-10'\\n  },\\n  {\\n    id: 2,\\n    title: '设计UI界面原型',\\n    description: '根据需求文档设计主要页面的UI原型图，包括首页、详情页和设置页',\\n    priority: 'high',\\n    status: 'pending',\\n    dueDate: '2024-01-20',\\n    createdAt: '2024-01-11'\\n  },\\n  {\\n    id: 3,\\n    title: '开发用户登录模块',\\n    description: '实现用户注册、登录、密码找回等核心功能',\\n    priority: 'medium',\\n    status: 'completed',\\n    dueDate: '2024-01-05',\\n    createdAt: '2024-01-01'\\n  },\\n  {\\n    id: 4,\\n    title: '测试API接口',\\n    description: '对后端提供的所有API接口进行功能测试和性能测试',\\n    priority: 'medium',\\n    status: 'pending',\\n    dueDate: '2024-01-25',\\n    createdAt: '2024-01-12'\\n  },\\n  {\\n    id: 5,\\n    title: '准备项目演示材料',\\n    description: '制作项目演示PPT和演示视频，准备向客户展示',\\n    priority: 'low',\\n    status: 'pending',\\n    dueDate: '2024-02-01',\\n    createdAt: '2024-01-13'\\n  }\\n])\\n\\nconst statusFilter = ref('all')\\nconst priorityFilter = ref('all')\\n\\nconst filteredTasks = computed(() => {\\n  return tasks.value.filter(task => {\\n    const statusMatch = statusFilter.value === 'all' || task.status === statusFilter.value\\n    const priorityMatch = priorityFilter.value === 'all' || task.priority === priorityFilter.value\\n    return statusMatch && priorityMatch\\n  })\\n})\\n\\nconst filterTasks = () => {\\n  // Filter is handled by computed property\\n}\\n\\nconst refreshTasks = () => {\\n  // In a real app, this would fetch updated tasks\\n  console.log('Tasks refreshed')\\n}\\n\\nonMounted(() => {\\n  // Initialize with sample data\\n})\\n</script>\\n\\n<style scoped>\\n.task-list-page {\\n  padding: 2rem 0;\\n}\\n\\n.page-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 2rem;\\n  flex-wrap: wrap;\\n  gap: 1rem;\\n}\\n\\n.page-header h1 {\\n  color: #2c3e50;\\n  font-size: 2.5rem;\\n}\\n\\n.filters {\\n  display: flex;\\n  gap: 1rem;\\n  margin-bottom: 2rem;\\n  flex-wrap: wrap;\\n}\\n\\n.filter-group {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n}\\n\\n.filter-group label {\\n  font-weight: 600;\\n  color: #495057;\\n}\\n\\n.filter-group select {\\n  padding: 0.5rem 1rem;\\n  border: 2px solid #dee2e6;\\n  border-radius: 6px;\\n  font-size: 1rem;\\n}\\n\\n.tasks-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));\\n  gap: 1.5rem;\\n}\\n\\n.no-tasks {\\n  text-align: center;\\n  padding: 4rem 0;\\n}\\n\\n.empty-state {\\n  max-width: 500px;\\n  margin: 0 auto;\\n}\\n\\n.empty-icon {\\n  font-size: 5rem;\\n  margin-bottom: 1rem;\\n  opacity: 0.3;\\n}\\n\\n.empty-state h3 {\\n  font-size: 2rem;\\n  color: #495057;\\n  margin-bottom: 1rem;\\n}\\n\\n.empty-state p {\\n  font-size: 1.1rem;\\n  color: #6c757d;\\n  margin-bottom: 2rem;\\n}\\n\\n.container {\\n  max-width: 1200px;\\n  margin: 0 auto;\\n  padding: 0 20px;\\n}\\n\\n@media (max-width: 768px) {\\n  .page-header {\\n    flex-direction: column;\\n    align-items: flex-start;\\n  }\\n  \\n  .filters {\\n    flex-direction: column;\\n  }\\n  \\n  .tasks-grid {\\n    grid-template-columns: 1fr;\\n  }\\n}\\n</style>\"}"
